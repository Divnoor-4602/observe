{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"auth_status": {
			"type": "string",
			"enum": [
				"authenticated",
				"anonymous"
			]
		},
		"deployment": {
			"type": "string"
		},
		"duration_ms": {
			"type": "number"
		},
		"environment": {
			"type": "string",
			"enum": [
				"production",
				"staging",
				"development"
			]
		},
		"error": {
			"type": "object",
			"properties": {
				"code": {
					"type": "string"
				},
				"message": {
					"type": "string"
				},
				"type": {
					"type": "string"
				}
			},
			"required": [
				"type"
			]
		},
		"event": {
			"type": "string"
		},
		"event_id": {
			"type": "string"
		},
		"experiment_key": {
			"type": "string"
		},
		"experiment_variant": {
			"type": "string"
		},
		"function_type": {
			"type": "string"
		},
		"method": {
			"type": "string"
		},
		"outcome": {
			"type": "string",
			"enum": [
				"success",
				"error",
				"cancelled"
			]
		},
		"parent_span_id": {
			"type": "string"
		},
		"region": {
			"type": "string"
		},
		"request_id": {
			"type": "string"
		},
		"route": {
			"type": "string"
		},
		"runtime": {
			"type": "string",
			"enum": [
				"web",
				"react_native",
				"convex",
				"python"
			]
		},
		"sample_rate": {
			"type": "number"
		},
		"sampled": {
			"type": "boolean"
		},
		"schema_version": {
			"type": "number",
			"const": 1
		},
		"sentry_event_id": {
			"type": "string"
		},
		"service": {
			"type": "string"
		},
		"service_version": {
			"type": "string"
		},
		"session_id": {
			"type": "string"
		},
		"span_id": {
			"type": "string"
		},
		"status_code": {
			"type": "number"
		},
		"trace_id": {
			"type": "string"
		},
		"ts": {
			"type": "string"
		},
		"user_id_hash": {
			"type": "string"
		},
		"user_tier": {
			"type": "string"
		}
	},
	"required": [
		"duration_ms",
		"environment",
		"event",
		"event_id",
		"outcome",
		"runtime",
		"schema_version",
		"span_id",
		"trace_id",
		"ts"
	],
	"additionalProperties": {},
	"$id": "https://ecogpt.dev/schemas/wide-event.schema.json",
	"title": "WideEvent",
	"description": "The envelope every wide event carries. Extra keys are allowed (open catalog); all keys recursively must match the snake_case pattern.",
	"propertyNames": {
		"pattern": "^[a-z][a-z0-9_]*$"
	}
}
